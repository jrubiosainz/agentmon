# Server port (Azure App Service will override this with its own PORT)
PORT=8080

# Node environment: development | production | test
NODE_ENV=development

# JWT signing secret. REQUIRED in production - the server will log a loud
# warning and fall back to an insecure development default if unset.
JWT_SECRET=change-me-to-a-long-random-string

# Azure Cosmos DB (NoSQL/SQL API). If COSMOS_ENDPOINT is omitted, the server
# falls back to an in-memory store (data is lost on restart) - handy for local
# dev and CI, but never persistent.
#
# COSMOS_KEY is optional. Leave it empty to authenticate with Entra ID via
# DefaultAzureCredential (managed identity in Azure, `az login` locally), which
# is what the deployed app does - the Cosmos account has local/key auth
# disabled, so there is no key to use.
COSMOS_ENDPOINT=
COSMOS_KEY=
COSMOS_DATABASE=agentmon

# Comma-separated list of origins allowed to call the API with credentials.
ALLOWED_ORIGINS=http://localhost:5173
