{
  "name": "@agentmon/client",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "i18n:scan": "node tools/i18n-scan.mjs",
    "i18n:check": "node tools/i18n-scan.mjs --check",
    "i18n:accents": "node tools/i18n-accents.mjs",
    "verify:i18n": "node tools/verify-i18n.mjs",
    "verify:gyms": "node tools/verify-gyms.mjs",
    "verify:fx": "node tools/verify-fx.mjs",
    "shot:fx": "node tools/shot-fx.mjs",
    "verify:overworld": "node tools/verify-overworld-fx.mjs",
    "verify:ambience": "node tools/verify-ambience.mjs",
    "verify:vs": "node tools/verify-vs.mjs"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
